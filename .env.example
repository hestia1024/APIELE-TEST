# Local app -> SSH tunnel -> server 127.0.0.1:3307 -> MySQL container
DB_HOST=127.0.0.1
DB_PORT=13307
DB_NAME=apiele_test_dev
DB_USER=apiele_dev
# Only put real credentials in .env; keep quotes if the password contains #.
DB_PASSWORD=""

# ssh handles the server login password/private key interactively.
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_REMOTE_DB_PORT=3307
